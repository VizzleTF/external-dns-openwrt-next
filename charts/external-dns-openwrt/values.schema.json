{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ownershipID": { "type": ["string", "null"] },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostname": { "type": ["string", "null"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tls": { "type": "boolean" },
        "insecureSkipVerify": { "type": "boolean" },
        "timeout": { "type": "integer", "minimum": 1 },
        "username": { "type": "string", "minLength": 1 },
        "password": { "type": ["string", "null"] },
        "existingSecret": { "type": ["string", "null"] },
        "existingSecretPasswordKey": { "type": "string", "minLength": 1 },
        "caBundle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configMapName": { "type": ["string", "null"] },
            "secretName": { "type": ["string", "null"] },
            "key": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "recordStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "externalDNS": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "service",
              "ingress",
              "crd",
              "gateway-httproute",
              "gateway-grpcroute",
              "gateway-tlsroute",
              "gateway-tcproute",
              "gateway-udproute"
            ]
          }
        },
        "domainFilters": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "policy": { "enum": ["sync", "upsert-only"] },
        "interval": { "type": "string", "minLength": 1 },
        "logLevel": { "enum": ["panic", "debug", "info", "warning", "error", "fatal"] },
        "logFormat": { "enum": ["text", "json"] },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "object" }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "logLevel": { "enum": ["debug", "info", "warn", "error"] },
        "logEncoding": { "enum": ["json", "console"] },
        "extraEnv": { "type": "array", "items": { "type": "object" } },
        "resources": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": ["string", "null"] },
        "annotations": { "type": "object" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "create": { "type": "boolean" } }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "hostAliases": { "type": "array" },
    "imagePullSecrets": { "type": "array" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "commonLabels": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "additionalLabels": { "type": "object" }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": ["string", "null"] },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    }
  }
}
